# ============================================
# OPS CONTROL - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Discord Bot Token (REQUIRED)
DISCORD_TOKEN=

# Discord Guild (Server) ID
GUILD_ID=1522060678113001473

# Bot Owner Discord User ID
OWNER_USER_ID=307113452760203266

# Arrivals Channel ID (for welcome messages)
ARRIVALS_CHANNEL_ID=1522222613991260403

# Timezone for timestamps (default: UTC)
TIMEZONE=UTC

# Database path (default: data/ops-control.db)
DATABASE_PATH=data/ops-control.db

# Log file path (default: logs/ops-control.log)
LOG_PATH=logs/ops-control.log

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# External API URLs
# ============================================
NOAA_API_URL=https://aviationweather.gov/api/data
FAA_NOTAM_API_URL=

# ============================================
# Admin API (for Discord admin dashboard)
# ============================================
DISCORD_ANNOUNCEMENT_CHANNEL=

# ============================================
# OPS ROOM Release Tracking
# ============================================
GITHUB_REPO=OpsRoomApp/ops-room-releases
OPSROOM_RELEASES_API=https://opsroom.live/api/update.json

# ============================================
# Bug Reports & Support Tickets
# ============================================
BUG_FORUM_CHANNEL_ID=
SUPPORT_FORUM_CHANNEL_ID=

# ============================================
# External API Keys (Optional)
# ============================================
# SimBrief API Key -- required for /ofp and /link-simbrief
# SIMBRIEF_API_KEY=

# ============================================
# Future: PostgreSQL Configuration
# ============================================
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/opscontrol
