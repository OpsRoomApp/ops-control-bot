# ==========================================================
# OPS CONTROL - Environment Configuration
# ==========================================================
# Copy this file to .env and fill in your values.

# --- REQUIRED ---
# Discord bot token (from Discord Developer Portal)
DISCORD_TOKEN=

# Discord server (guild) ID
GUILD_ID=1522060678113001473

# Bot owner Discord user ID
OWNER_USER_ID=307113452760203266

# Channel for automatic welcome messages on member join
ARRIVALS_CHANNEL_ID=1522222613991260403

# --- RECOMMENDED ---
# Channel where /announce sends messages
DISCORD_ANNOUNCEMENT_CHANNEL=1522225431242080377

# Channel where bot audit logs are sent
LOG_CHANNEL_ID=1532821757181034568

# --- TICKET SYSTEM ---
# Category where ticket channels are created
SUPPORT_CATEGORY_ID=1532835008186683463

# Channel where bug report notifications are posted
BUG_REPORTS_CHANNEL_ID=1532835252970586213

# Channel where closed-ticket transcripts are archived
TICKET_TRANSCRIPT_CHANNEL_ID=1532835195844038666

# Role IDs for ticket channel permissions
SUPPORT_DISPATCH_ROLE_ID=1522239775099322459
MODERATOR_ROLE_ID=1522239890597740544
OPS_CONTROL_ROLE_ID=1532786008926589008

# Role mentioned on new bug reports (Developer team)
DEVELOPER_ROLE_ID=1522239714164478033

# --- BETA TESTER PROGRAM ---
# Role granted to beta coordinators (can manage testers)
BETA_COORDINATOR_ROLE_ID=1522240043685646348
# Roles granted to beta testers by /betatester add
VERIFIED_TESTER_ROLE_ID=1522240748420989169
PUBLIC_BETA_ROLE_ID=1522240651368992918

# --- SIMBRIEF (no API key required) ---
# Optional default SimBrief account used for route-generation links
# when a user has not linked their own account via /link-simbrief.
SIMBRIEF_USER_ID=
SIMBRIEF_STATIC_ID=

# --- WHERE2FLY ROUTE API (OPTIONAL) ---
# Where2Fly is the primary random-route provider when enabled with a token.
# Without a token the bot starts normally and uses the local fallback engine.
# The API anchors on exactly ONE airport per request (departure OR arrival);
# the bot sends an arrivalWhitelist when both endpoints are requested.
WHERE2FLY_ENABLED=true
# Token issued by Where2Fly (contact Blt950 on Discord) - bind it to the
# bot's VPS IP. Use the QA environment for testing:
#   WHERE2FLY_API_BASE_URL=https://qa.where2fly.today/
# and switch to https://where2fly.today/ for production.
WHERE2FLY_API_TOKEN=
WHERE2FLY_API_BASE_URL=https://where2fly.today/
WHERE2FLY_TIMEOUT_SECONDS=15

# --- PENDING ACTION DISPATCHER ---
# Interval (seconds) the bot polls the admin-panel action queue.
PENDING_ACTION_POLL_SECONDS=15
# Maximum attempts before an action is marked failed.
PENDING_ACTION_MAX_ATTEMPTS=3

# --- MODERATION (B2) ---
# Channel where moderation action embeds are posted (warn/kick/ban/timeout/automod).
MOD_LOG_CHANNEL_ID=
# Role granted by /mute (role-based mute; supports permanent/long-duration mutes).
MUTED_ROLE_ID=

# --- VATSIM EVENT REMINDERS (B3) ---
# Channel where new VATSIM events + start reminders are posted.
VATSIM_EVENTS_CHANNEL_ID=
# Announcement is posted when the event is within this many minutes of start.
VATSIM_EVENTS_ANNOUNCE_MINUTES=90
# Reminder is posted when the event is within this many minutes of start.
VATSIM_EVENTS_REMINDER_MINUTES=30

# --- VATSIM FLIGHT TRACKER (auto takeoff/landing posts) ---
# Channel where takeoff / landing notifications for linked CIDs are posted.
VATSIM_TRACKER_CHANNEL_ID=1533447716359639131
# How often (seconds) the tracker polls the VATSIM data feed (default 60).
VATSIM_TRACKER_POLL_SECONDS=60

# --- OPS ROOM COMMUNITY FLIGHT EVENTS (desktop app -> Discord) ---
# Channel where takeoff / landing events from the desktop app are posted.
# Shares the default with the VATSIM tracker so both sources land in one feed.
FLIGHTS_CHANNEL_ID=1533447716359639131
# Master switch for the desktop-app community integration (default true).
COMMUNITY_ENABLED=true
# Default visibility for newly linked users (discord | public | hidden).
COMMUNITY_PUBLIC_BY_DEFAULT=false

# --- OPS ROOM ADMIN API INTEGRATION (B1 hosted transcripts + C4 appeals) ---
# Base URL of the admin API (used to POST closed-ticket transcripts and
# resolve hosted transcript links).
ADMIN_API_BASE_URL=https://admin.opsroom.live
# Shared bearer token; must match ADMIN_API_TOKEN in the website .env.
# Required only if hosted transcript delivery is desired.
ADMIN_API_TOKEN=
# Public appeal form URL shown in ban/timeout DMs.
APPEAL_FORM_URL=https://opsroom.live/appeal

# --- Scambait channel ---
# Anyone (non-staff) who posts in this channel is automatically soft-banned (timeout).
# Soft-ban duration in minutes (Discord caps timeouts at 28 days = 40320 min).
SCAMBAIT_CHANNEL_ID=1536709558704283800
SCAMBAIT_TIMEOUT_MINUTES=60

# --- Member verification gate ---
# Channel hosting the persistent Verify button; members click it to gain the member role.
# Set VERIFY_MEMBER_ROLE_ID (role to grant) and optionally VERIFY_UNVERIFIED_ROLE_ID (role to remove).
VERIFY_CHANNEL_ID=1536723890259099839
VERIFY_MEMBER_ROLE_ID=
VERIFY_UNVERIFIED_ROLE_ID=

# --- OPS ROOM release tracking (v0.25.x) ---
# /latest and /changelog read opsroom.live/api/public/releases first (the
# admin-panel release notes), with GitHub + update.json as fallbacks. Nothing
# to set unless you want to override the defaults below.
# OPSROOM_PUBLIC_RELEASES_API=https://opsroom.live/api/public/releases
# Hide anything older than this from /changelog (empty = show all history).
CHANGELOG_MIN_VERSION=0.25.0
